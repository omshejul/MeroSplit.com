DATABASE_URL=
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=
DEBUG=
R2_BUCKET=
R2_ENDPOINT_URL=
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Keep Resend credentials for unmarked frozen deliveries after Cloudflare cutover.
RESEND_API_KEY=
# Switch to cloudflare only after migration and compatible API/worker rollout.
EMAIL_PROVIDER=resend
CLOUDFLARE_EMAIL_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
DEFAULT_FROM_EMAIL='MeroSplit <mail@merosplit.com>'
EMAIL_REPLY_TO=mail@merosplit.com
PUBLIC_WEB_URL=https://merosplit.com
# Local/default: ignore proxy IP headers. Public Railway deployment must opt in.
EMAIL_CLIENT_IP_SOURCE=remote_addr
EMAIL_RAILWAY_PUBLIC_HOSTS=
# Optional private store-demo identity/credential configuration; absent disables it.
STORE_REVIEW_AUTH_JSON=[]
# API only: enable after migrations, exact public clients/callbacks and auth QA.
GOOGLE_SIGN_IN_ENABLED=false
GOOGLE_OAUTH_WEB_CLIENT_ID=1091299527858-dmjm6sosrpqc7054m5nv6drpkgd03sma.apps.googleusercontent.com

# Enable on API and worker after configuring native credentials in EAS.
PUSH_PROVIDER=
# Optional; only required when Expo enhanced push security is enabled.
EXPO_ACCESS_TOKEN=
