DATABASE_URL=
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=
DEBUG=
R2_BUCKET=
R2_ENDPOINT_URL=
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
RESEND_API_KEY=
DEFAULT_FROM_EMAIL='MeroSplit <mail@merosplit.com>'
EMAIL_REPLY_TO=mail@merosplit.com
PUBLIC_WEB_URL=https://api-production-fb6ac.up.railway.app
# Local/default: ignore proxy IP headers. Public Railway deployment must opt in.
EMAIL_CLIENT_IP_SOURCE=remote_addr
EMAIL_RAILWAY_PUBLIC_HOSTS=
