{
  "expo": {
    "name": "MeroSplit",
    "slug": "splitdumb",
    "scheme": "splitdumb",
    "version": "0.3.6",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.omshejul.splitdumb",
      "buildNumber": "14",
      "associatedDomains": [
        "applinks:merosplit.omshejul.com"
      ],
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "upi",
          "gpay",
          "phonepe",
          "paytmmp",
          "credpay",
          "bhim",
          "amazonpay"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.omshejul.splitdumb",
      "versionCode": 14,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {"scheme": "https", "host": "merosplit.omshejul.com", "pathPrefix": "/app/sign-in/"},
            {"scheme": "https", "host": "merosplit.omshejul.com", "pathPrefix": "/app/groups/"},
            {"scheme": "https", "host": "merosplit.omshejul.com", "pathPrefix": "/app/invite/"},
            {"scheme": "https", "host": "merosplit.omshejul.com", "pathPrefix": "/invite/"}
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-notifications",
        {
          "defaultChannel": "shared-bills",
          "enableRemoteNotifications": true,
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a profile photo or a bill image for MeroSplit.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/with-monochrome.cjs",
      "./plugins/with-upi.cjs",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ]
    ],
    "primaryColor": "#161616",
    "extra": {
      "eas": {
        "projectId": "7b058184-31a7-41e9-96e1-5a752b7bf14f"
      }
    }
  }
}
