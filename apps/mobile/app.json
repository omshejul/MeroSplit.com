{
  "expo": {
    "name": "MeroSplit",
    "slug": "splitdumb",
    "scheme": "splitdumb",
    "version": "0.3.3",
    "orientation": "portrait",
    "icon": "./assets/android-icon-monochrome.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.omshejul.splitdumb",
      "buildNumber": "6",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.omshejul.splitdumb",
      "versionCode": 6,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-monochrome.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/android-icon-monochrome.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-notifications",
        {
          "defaultChannel": "shared-bills",
          "enableRemoteNotifications": true,
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a profile photo or a bill image for MeroSplit.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/with-monochrome.cjs"
    ],
    "primaryColor": "#161616",
    "extra": {
      "eas": {
        "projectId": "7b058184-31a7-41e9-96e1-5a752b7bf14f"
      }
    }
  }
}
