{
  "expo": {
    "name": "MeroSplit",
    "slug": "splitdumb",
    "scheme": "splitdumb",
    "version": "1.2.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.omshejul.splitdumb",
      "buildNumber": "34",
      "associatedDomains": [
        "applinks:merosplit.com",
        "applinks:merosplit.omshejul.com"
      ],
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "upi",
          "gpay",
          "phonepe",
          "paytmmp",
          "credpay",
          "bhim",
          "amazonpay"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      },
      "icon": "./assets/brand/merosplit.icon",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.omshejul.splitdumb",
      "version": "1.2.3",
      "versionCode": 33,
      "blockedPermissions": ["android.permission.CAMERA"],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "merosplit.com",
              "pathPrefix": "/app/sign-in/"
            },
            {
              "scheme": "https",
              "host": "merosplit.com",
              "pathPrefix": "/app/groups/"
            },
            {
              "scheme": "https",
              "host": "merosplit.com",
              "pathPrefix": "/app/invite/"
            },
            {
              "scheme": "https",
              "host": "merosplit.com",
              "pathPrefix": "/invite/"
            },
            {
              "scheme": "https",
              "host": "merosplit.com",
              "pathPrefix": "/j/"
            },
            {
              "scheme": "https",
              "host": "merosplit.omshejul.com",
              "pathPrefix": "/app/sign-in/"
            },
            {
              "scheme": "https",
              "host": "merosplit.omshejul.com",
              "pathPrefix": "/app/groups/"
            },
            {
              "scheme": "https",
              "host": "merosplit.omshejul.com",
              "pathPrefix": "/app/invite/"
            },
            {
              "scheme": "https",
              "host": "merosplit.omshejul.com",
              "pathPrefix": "/invite/"
            }
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "react-native-nitro-google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1091299527858-189bnq3gr66tm2a1jsecvmd93n1s150a"
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "expo-font",
      "./plugins/with-font-license.cjs",
      [
        "expo-notifications",
        {
          "defaultChannel": "shared-bills",
          "enableRemoteNotifications": true,
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a profile photo or a bill image for MeroSplit.",
          "cameraPermission": "MeroSplit uses your camera so you can take a photo of a receipt or bill and attach it to an expense.",
          "microphonePermission": false
        }
      ],
      "./plugins/with-monochrome.cjs",
      "./plugins/with-upi.cjs",
      "./plugins/with-app-icons.cjs",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "om-shejul",
          "project": "merosplit-app",
          "url": "https://sentry.io/"
        }
      ]
    ],
    "primaryColor": "#161616",
    "extra": {
      "eas": {
        "projectId": "7b058184-31a7-41e9-96e1-5a752b7bf14f"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/7b058184-31a7-41e9-96e1-5a752b7bf14f",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "merosplit-production"
      }
    }
  }
}
