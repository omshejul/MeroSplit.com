{
  "expo": {
    "name": "MeroSplit",
    "slug": "splitdumb",
    "scheme": "splitdumb",
    "version": "1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.omshejul.splitdumb",
      "buildNumber": "22",
      "associatedDomains": [
        "applinks:merosplit.com",
        "applinks:merosplit.omshejul.com"
      ],
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "upi",
          "gpay",
          "phonepe",
          "paytmmp",
          "credpay",
          "bhim",
          "amazonpay"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      },
      "icon": "./assets/brand/merosplit.icon"
    },
    "android": {
      "package": "com.omshejul.splitdumb",
      "versionCode": 21,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "merosplit.com",
              "pathPrefix": "/app/sign-in/"
            },
            {
              "scheme": "https",
              "host": "merosplit.com",
              "pathPrefix": "/app/groups/"
            },
            {
              "scheme": "https",
              "host": "merosplit.com",
              "pathPrefix": "/app/invite/"
            },
            {
              "scheme": "https",
              "host": "merosplit.com",
              "pathPrefix": "/invite/"
            },
            {
              "scheme": "https",
              "host": "merosplit.com",
              "pathPrefix": "/j/"
            },
            {
              "scheme": "https",
              "host": "merosplit.omshejul.com",
              "pathPrefix": "/app/sign-in/"
            },
            {
              "scheme": "https",
              "host": "merosplit.omshejul.com",
              "pathPrefix": "/app/groups/"
            },
            {
              "scheme": "https",
              "host": "merosplit.omshejul.com",
              "pathPrefix": "/app/invite/"
            },
            {
              "scheme": "https",
              "host": "merosplit.omshejul.com",
              "pathPrefix": "/invite/"
            }
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "expo-font",
      "./plugins/with-font-license.cjs",
      [
        "expo-notifications",
        {
          "defaultChannel": "shared-bills",
          "enableRemoteNotifications": true,
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a profile photo or a bill image for MeroSplit.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/with-monochrome.cjs",
      "./plugins/with-upi.cjs",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ]
    ],
    "primaryColor": "#161616",
    "extra": {
      "eas": {
        "projectId": "7b058184-31a7-41e9-96e1-5a752b7bf14f"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/7b058184-31a7-41e9-96e1-5a752b7bf14f",
      "checkAutomatically": "NEVER",
      "requestHeaders": {
        "expo-channel-name": "merosplit-1-1-testing"
      }
    }
  }
}
