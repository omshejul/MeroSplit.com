{
  "expo": {
    "name": "MeroSplit",
    "slug": "splitdumb",
    "scheme": "splitdumb",
    "version": "0.3.1",
    "orientation": "portrait",
    "icon": "./assets/android-icon-monochrome.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.omshejul.splitdumb",
      "buildNumber": "4",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.omshejul.splitdumb",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-monochrome.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/android-icon-monochrome.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "expo-font",
      ["expo-image-picker", {"photosPermission": "Choose a profile photo or a bill image for MeroSplit.", "cameraPermission": false, "microphonePermission": false}],
      "./plugins/with-monochrome.cjs"
    ],
    "primaryColor": "#161616"
  }
}
