{
  "cli": {
    "appVersionSource": "local",
    "requireCommit": true
  },
  "build": {
    "beta": {
      "distribution": "store",
      "credentialsSource": "remote",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://merosplit.com"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "pnpm": "12.14.0",
      "channel": "merosplit-production"
    },
    "production": {
      "extends": "beta",
      "channel": "merosplit-production"
    }
  },
  "submit": {
    "beta": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      },
      "ios": {
        "appleTeamId": "M4K84L4TKR",
        "ascAppId": "6823916128"
      }
    }
  }
}
